# PDS-related variables
PDS_ADMIN_PASSWORD=""
PDS_ENDPOINT=""

# Manager-related variables
DATABASE_URL="database.sqlite"
SESSION_SECRET="64-character-secret-key"
DB_MIN_IDLE="1"
SERVER_PORT="9090"
ALLOWED_ORIGIN="*"
SESSION_COOKIE_SECURE="true"

# Cloudflare Access — required only for the machine-facing
# POST /invite-codes/issue endpoint. Without both of the first two set, that
# endpoint refuses every request.
# Your Access team domain:
CF_ACCESS_TEAM_DOMAIN=""
# The Access application's AUD tag (Access > Applications > Overview):
CF_ACCESS_AUD=""
# Optional. Comma-separated service token names permitted to issue codes.
# Empty means anything the Access policy admits is accepted.
CF_ACCESS_ALLOWED_SERVICE_TOKENS=""
